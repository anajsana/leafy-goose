# Copy this file to .env and fill it in

# Discord Developer Portal 
DISCORD_TOKEN=                # Bot → Reset Token. Secret.
DISCORD_CLIENT_ID=            # General Information → Application ID
DISCORD_GUILD_ID=             # Right-click your server → Copy Server ID

# Who can use the bot: the reviewers (moderators, lead maintainers, community managers)
# One or more Discord user IDs, comma-separated
DISCORD_ALLOWED_USER_ID=

# Optional: channels where the bot works, comma-separated. Empty = all channels
DISCORD_ALLOWED_CHANNEL_IDS=

# goose
GOOSE_BIN=goose               # full path if goose is not on PATH
GOOSE_MODEL=                  # optional; empty = goose's configured model
GOOSE_TIMEOUT_SECONDS=120

# Optional: path to your community guide. Default: skills/drf-community-guide/SKILL.md
GUIDE_PATH=
